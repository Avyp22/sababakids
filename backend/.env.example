# Optional — leave empty to run without a database (only used for an anonymous search log).
# Free option: MongoDB Atlas M0 → mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net
MONGO_URL=
DB_NAME=sababakids

# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=https://chipper-gumdrop-477ddd.netlify.app,http://localhost:3000

# Google Places (New) + Geocoding API key. Empty = curated Israeli data only.
GOOGLE_MAPS_API_KEY=

# rich (default) = rating + opening hours ; basic = cheaper Google tier (larger free quota)
GOOGLE_PLACES_DETAIL=rich
